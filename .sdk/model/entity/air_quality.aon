# Entity: air_quality

main: kit: entity: air_quality: {

  alias: field: {}

  fields: [
    {
      name: "current"
      req: false
      short: "Current conditions data"
      type: "`$OBJECT`"
    }
    {
      name: "current_units"
      req: false
      short: "Units for current conditions variables"
      type: "`$OBJECT`"
    }
    {
      name: "elevation"
      req: false
      short: "Elevation in meters of the selected grid cell"
      type: "`$NUMBER`"
    }
    {
      name: "generationtime_ms"
      req: false
      short: "Generation time of the forecast in milliseconds"
      type: "`$NUMBER`"
    }
    {
      name: "hourly"
      req: false
      short: "Hourly forecast data"
      type: "`$OBJECT`"
    }
    {
      name: "hourly_units"
      req: false
      short: "Units for each hourly variable"
      type: "`$OBJECT`"
    }
    {
      name: "latitude"
      req: false
      short: "WGS84 latitude of the center of the weather grid-cell used for the forecast"
      type: "`$NUMBER`"
    }
    {
      name: "longitude"
      req: false
      short: "WGS84 longitude of the center of the weather grid-cell used for the forecast"
      type: "`$NUMBER`"
    }
    {
      name: "timezone"
      req: false
      short: "Timezone identifier (e.g., Europe/Berlin)"
      type: "`$STRING`"
    }
    {
      name: "timezone_abbreviation"
      req: false
      short: "Timezone abbreviation (e.g., CEST)"
      type: "`$STRING`"
    }
    {
      name: "utc_offset_seconds"
      req: false
      short: "Applied timezone offset in seconds"
      type: "`$INTEGER`"
    }
  ]

  name: "air_quality"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "apikey"
                orig: "apikey"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "nearest"
                kind: "query"
                name: "cell_selection"
                orig: "cell_selection"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "european_aqi,pm10,pm2_5"
                kind: "query"
                name: "current"
                orig: "current"
                reqd: false
                type: "`$ANY`"
              }
              {
                example: "auto"
                kind: "query"
                name: "domain"
                orig: "domain"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2024-01-07"
                kind: "query"
                name: "end_date"
                orig: "end_date"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2024-01-07T23:00"
                kind: "query"
                name: "end_hour"
                orig: "end_hour"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 5
                kind: "query"
                name: "forecast_day"
                orig: "forecast_day"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "forecast_hour"
                orig: "forecast_hour"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "pm10,pm2_5,european_aqi"
                kind: "query"
                name: "hourly"
                orig: "hourly"
                reqd: false
                type: "`$ANY`"
              }
              {
                example: 52.52
                kind: "query"
                name: "latitude"
                orig: "latitude"
                reqd: true
                type: "`$NUMBER`"
              }
              {
                example: 13.419
                kind: "query"
                name: "longitude"
                orig: "longitude"
                reqd: true
                type: "`$NUMBER`"
              }
              {
                example: 0
                kind: "query"
                name: "past_day"
                orig: "past_day"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "past_hour"
                orig: "past_hour"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "2024-01-01"
                kind: "query"
                name: "start_date"
                orig: "start_date"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "2024-01-01T00:00"
                kind: "query"
                name: "start_hour"
                orig: "start_hour"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "iso8601"
                kind: "query"
                name: "timeformat"
                orig: "timeformat"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Europe/Berlin"
                kind: "query"
                name: "timezone"
                orig: "timezone"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/air-quality"
          parts: [
            "v1"
            "air-quality"
          ]
          select: {
            exist: [
              "apikey"
              "cell_selection"
              "current"
              "domain"
              "end_date"
              "end_hour"
              "forecast_day"
              "forecast_hour"
              "hourly"
              "latitude"
              "longitude"
              "past_day"
              "past_hour"
              "start_date"
              "start_hour"
              "timeformat"
              "timezone"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
